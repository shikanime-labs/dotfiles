#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = "William Phetsinorath"
email = "william.phetsinorath@shikanime.studio"

[operation]
mode = "snapshot"
auto-update-interval = "7d"

[git]
private-commits = "description(substring:\"[private]\")"
auto-local-branch = true
push-bookmark-prefix = "push-"

[signing]
backend = "ssh"
key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPFC5VCX4U04t82TizoUmXxZ064cOqNtswe0zPDqWWRj"
behaviour = "own"

[remotes.upstream]
auto-track-bookmarks = "main"

[ui]
movement.edit = true
default-command = "log"
pager = "less -FRX"
editor = "hx"

[aliases]
prune = ["abandon", "nulls()", "conflicts()"]
restack = ["rebase", "--onto", "trunk()", "--source", "roots(trunk()..) & mutable()", "--simplify-parents"]
stack = ["rebase", "--after", "trunk()", "--before", "closest_merge(@)"]
stage = ["stack", "-r", "closest_merge(@)+:: ~ empty()"]
fetch = ["git", "fetch", "--all-remotes"]
switch = ["workspace", "add"]
push = ["git", "push"]
l = ["log", "-r", "(main..@):: | (..main)~@"]
s = ["status"]
n = ["new"]
co = ["checkout"]
br = ["branch"]

[revset-aliases]
"trunk()" = "main@origin"
"closest_merge(to)" = "heads(::to & merges())"
"nulls()" = "empty() & mutable()"

[templates]
commit_trailers = "format_signed_off_by_trailer(self)\n++ if(!trailers.contains_key(\"Change-Id\"), format_gerrit_change_id_trailer(self))"
