#!/usr/bin/env bash
# chezmoi post-apply hook: re-encrypt the *.sops.* source files so the repo
# never holds plaintext secrets. Pairs with sops-decrypt-on-apply.
set -euo pipefail

KEY_FILE="${SOPS_AGE_KEY_FILE:-C:/Users/shika/.config/sops/age/keys.txt}"
export SOPS_AGE_KEY_FILE="$KEY_FILE"
SOPS_CONFIG="${SOPS_CONFIG:-C:/Users/shika/dev/dotfiles/.sops.yaml}"

mapfile -t SOPS_FILES < <(find "$SOURCE_DIR" -type f -name '*.sops.*' 2>/dev/null || true)
if [ "${#SOPS_FILES[@]}" -eq 0 ]; then
  exit 0
fi

for f in "${SOPS_FILES[@]}"; do
  sops --encrypt --config "$SOPS_CONFIG" "$f" > "$f.tmp"
  mv "$f.tmp" "$f"
done
